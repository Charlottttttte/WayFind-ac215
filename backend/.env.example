# Used by backend/compose.yaml. For local runs without Docker, export the WAYFIND_* variables.
BACKEND_PORT=8000
# File inside the repository's data/ directory to index.
WAYFIND_DATA_FILE=scraped_sheet1.csv
# Optional: label the index with the ingestion snapshot ID; defaults to the CSV's dataset_version or a SHA-256 of the file.
WAYFIND_DATASET_VERSION=
# Results whose best chunk has cosine similarity below this are dropped.
WAYFIND_MIN_SCORE=0.25
