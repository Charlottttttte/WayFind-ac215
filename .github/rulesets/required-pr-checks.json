{
  "name": "Require passing PR checks",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH", "refs/heads/milestone*"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          {"context": "JavaScript tests", "integration_id": 15368},
          {"context": "Python and API tests", "integration_id": 15368},
          {"context": "Docker build and smoke test", "integration_id": 15368},
          {"context": "Backend retrieval tests", "integration_id": 15368},
          {"context": "Backend Docker build and retrieval smoke test", "integration_id": 15368}
        ],
        "strict_required_status_checks_policy": true
      }
    }
  ]
}
